{
  "contract": "actor-typed-dsl.session-runtime",
  "contractVersion": "1.0.0",
  "protocol": {
    "Client": {
      "kind": "select",
      "peer": "Server",
      "branches": {
        "Ping": {
          "payload": "Unit",
          "next": { "kind": "end" }
        }
      }
    }
  },
  "role": "Client",
  "events": [
    {
      "action": "receive",
      "peer": "Server",
      "label": "Ping",
      "payload": "Unit"
    }
  ]
}
