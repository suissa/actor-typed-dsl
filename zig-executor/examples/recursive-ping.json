{
  "contract": "actor-typed-dsl.session-runtime",
  "contractVersion": "1.0.0",
  "protocol": {
    "Client": {
      "kind": "mu",
      "variable": "X",
      "body": {
        "kind": "select",
        "peer": "Server",
        "branches": {
          "Ping": {
            "payload": "Unit",
            "next": { "kind": "ref", "variable": "X" }
          },
          "Quit": {
            "payload": "Unit",
            "next": { "kind": "end" }
          }
        }
      }
    },
    "Server": {
      "kind": "mu",
      "variable": "Y",
      "body": {
        "kind": "offer",
        "peer": "Client",
        "branches": {
          "Ping": {
            "payload": "Unit",
            "next": { "kind": "ref", "variable": "Y" }
          },
          "Quit": {
            "payload": "Unit",
            "next": { "kind": "end" }
          }
        }
      }
    }
  },
  "role": "Client",
  "events": [
    { "action": "send", "peer": "Server", "label": "Ping", "payload": "Unit" },
    { "action": "send", "peer": "Server", "label": "Ping", "payload": "Unit" },
    { "action": "send", "peer": "Server", "label": "Quit", "payload": "Unit" }
  ]
}
